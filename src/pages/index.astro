---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import PricingCard from '../components/PricingCard.astro';
import GuaranteeCard from '../components/GuaranteeCard.astro';
import FAQ from '../components/FAQ.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Shmoney Web Design',
  description:
    'Baltimore web design agency building fast, no-nonsense websites and providing monthly maintenance for local small businesses.',
  url: 'https://shmoneywebdesign.com', // TODO: real domain
  telephone: '[Phone]', // TODO: real phone number
  email: '[Email]', // TODO: real email
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Baltimore',
    addressRegion: 'MD',
    addressCountry: 'US',
  },
  areaServed: {
    '@type': 'City',
    name: 'Baltimore',
  },
  priceRange: '$$',
  serviceType: 'Web Design and Development',
};

const starterFeatures = [
  'Up to 5 pages',
  'Mobile-optimized, fast design',
  'Contact form',
  'Hosting, domain setup, SSL — all handled',
  'Google Business Profile optimization',
  'Monthly backups and security updates',
];

const standardFeatures = [
  'Up to 7 pages',
  'Everything in Starter',
  'Booking or payment system integration',
  'Basic local SEO setup',
  'Monthly content updates (1 hr/mo)',
  'Priority email support',
];

const faqItems = [
  {
    q: "I already have a website but it's old. Can you just fix it?",
    a: "Yes, often that's cheaper than a full rebuild. Send us the URL and we'll assess — sometimes a refresh is all it takes. Sometimes the foundation is bad enough that starting over is smarter. We'll tell you honestly which one applies.",
  },
  {
    q: "What if I don't have photos or a logo?",
    a: "We handle it. For photos, we'll use high-quality licensed stock images of Baltimore and your industry until you get real ones — and real photos are always better, so we'll walk you through getting them. For logos, we can do a simple wordmark or refer you to someone affordable.",
  },
  {
    q: 'How long does it take?',
    a: "Typically 2–3 weeks from the day we get your signed agreement and deposit. The fastest builds happen when clients give us their content quickly. We set two review checkpoints along the way — you're not in the dark.",
  },
  {
    q: 'What happens if I want to cancel?',
    a: "Cancel anytime. No contracts, no lock-in. You'll keep the site — it's yours. We just won't be hosting or maintaining it anymore. We'll give you the files and access to everything so you can move it anywhere.",
  },
  {
    q: 'Do I own the website?',
    a: "Yes. Always. Your domain is registered in your name. Your content is your content. We do the work but we don't hold your site hostage. This is non-negotiable for us.",
  },
  {
    q: 'Why are you so much cheaper than a big agency?',
    a: "We're small, local, and we specialize in exactly one thing: small local businesses. No sales team. No account managers. No office in Harbor East with exposed brick and a beer fridge. You're paying for the work, not the overhead. We also don't do Fortune 500 work — so we price for the market we actually serve.",
  },
  {
    q: "You're new. Why should I trust you?",
    a: "Fair question. We're new as a business, not new to building websites. We're Baltimore-based, not a faceless operation in another state. And we back everything with a full money-back guarantee: live in 21 days or you get a refund. Not happy 30 days after launch? Full refund, and we transfer the site to you free. If we don't deliver, you don't pay — period.",
  },
];
---

<Layout
  title="Baltimore Web Design for Small Businesses"
  description="We build fast, no-nonsense websites for Baltimore small businesses — and handle everything so you don't have to learn a thing."
  jsonLd={schema}
>
  <!-- HERO -->
  <section id="hero" class="bg-cream py-16 md:py-24 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl lg:text-6xl text-ink leading-tight mb-6">
          Baltimore small businesses deserve websites that actually bring in customers.
        </h1>
        <p class="text-lg md:text-xl text-muted leading-relaxed mb-8 max-w-2xl">
          We build fast, no-nonsense websites for local businesses — and we handle the whole thing so you don't have to learn anything new.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 mb-8">
          <a
            href="/audit"
            class="inline-block bg-navy text-white px-7 py-4 rounded font-semibold text-base hover:bg-navy-dark transition-colors text-center focus-visible:outline-2 focus-visible:outline-navy"
          >
            Get a free site audit
          </a>
          <a
            href="#pricing"
            class="inline-block border-2 border-navy text-navy px-7 py-4 rounded font-semibold text-base hover:bg-navy hover:text-white transition-colors text-center focus-visible:outline-2 focus-visible:outline-navy"
          >
            See pricing
          </a>
        </div>
        <p class="text-sm text-muted flex items-center gap-1">
          <svg class="shrink-0 text-navy" width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
          </svg>
          Built in Baltimore. Serving businesses from Canton to Catonsville.
        </p>
      </div>

      <!-- TODO: Replace with a real Baltimore photo (e.g., a local storefront on Eastern Ave or Charles St). Recommended: 1200x500px, your own photo preferred over stock. -->
      <div class="mt-12 bg-navy-light rounded-xl h-64 md:h-80 flex items-center justify-center border-2 border-dashed border-navy" role="img" aria-label="Baltimore photo placeholder">
        <p class="text-white opacity-40 text-sm text-center px-4">TODO: Replace with real Baltimore photo</p>
      </div>
    </div>
  </section>

  <!-- PROBLEM -->
  <section id="problem" class="bg-white py-16 md:py-20 px-4">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl md:text-4xl text-ink mb-12 max-w-2xl">
        If your "website" is a Facebook page, you're losing customers every day.
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <div class="w-10 h-10 bg-cream rounded-lg flex items-center justify-center mb-4" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-navy">
              <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-ink mb-2" style="font-family: var(--font-sans);">Customers search Google first, not Facebook.</h3>
          <p class="text-muted text-sm leading-relaxed">
            When someone needs a plumber in Dundalk or a hair salon in Towson, they open Google — not Facebook. If you don't show up in search results, that customer calls your competitor. A real website is how you show up.
          </p>
        </div>
        <div>
          <div class="w-10 h-10 bg-cream rounded-lg flex items-center justify-center mb-4" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-navy">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-ink mb-2" style="font-family: var(--font-sans);">A bad site is worse than no site.</h3>
          <p class="text-muted text-sm leading-relaxed">
            A slow, broken, or outdated website doesn't just fail to help you — it actively costs you customers. People make snap judgments online. If your site looks abandoned, they assume your business is too.
          </p>
        </div>
        <div>
          <div class="w-10 h-10 bg-cream rounded-lg flex items-center justify-center mb-4" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-navy">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-ink mb-2" style="font-family: var(--font-sans);">You don't have time to figure this out.</h3>
          <p class="text-muted text-sm leading-relaxed">
            You're running a business. You're answering calls, scheduling jobs, managing people. Learning web design, hosting, and SEO is a full-time job in itself. That's what we're here for.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT WE DO -->
  <section id="services" class="bg-cream py-16 md:py-20 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
        <div>
          <h2 class="text-3xl md:text-4xl text-ink mb-6">One simple offer.</h2>
          <p class="text-muted leading-relaxed mb-4">
            We don't do a hundred different things. We build fast, effective websites for local Baltimore businesses and keep them running. That's it.
          </p>
          <p class="text-muted leading-relaxed">
            One point of contact. No handoffs. No surprise bills. The person who built your site is the same person who answers your emails.
          </p>
        </div>
        <ul class="space-y-3" role="list">
          {[
            'Custom-designed website (5–7 pages typical)',
            'Mobile-optimized and fast — tested on real phones',
            'Built for search — Google-friendly from day one',
            'Hosting, domain setup, business email, and SSL — all handled',
            'Monthly updates, backups, and security monitoring',
            'Google Business Profile optimization included',
            'Contact forms, booking systems, or payment integration as needed',
            'You review at two checkpoints before launch',
          ].map(item => (
            <li class="flex items-start gap-3">
              <svg class="mt-0.5 shrink-0 text-success" width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-ink text-sm leading-relaxed">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section id="pricing" class="bg-white py-16 md:py-20 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl text-ink mb-4">Straightforward pricing. No surprises.</h2>
        <p class="text-muted max-w-xl mx-auto">
          Most agencies won't show you prices. We do — because you shouldn't have to sit through a sales call just to find out if you can afford it.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl mx-auto">
        <PricingCard
          tier="Starter"
          buildFee="$1,500"
          monthly="$99"
          features={starterFeatures}
          badge="Founding client pricing — first 5 clients only"
          ctaHref="/audit"
          ctaText="Claim this rate"
        />
        <PricingCard
          tier="Standard"
          buildFee="$2,500"
          monthly="$179"
          features={standardFeatures}
          highlighted={true}
          ctaHref="/audit"
          ctaText="Get started"
        />
      </div>

      <p class="text-center mt-8 text-sm text-muted">
        Need e-commerce, custom booking, or something bigger?
        <a href="/contact" class="text-navy font-medium hover:underline">Let's talk</a> — we'll scope it out for free.
      </p>
    </div>
  </section>

  <!-- GUARANTEE -->
  <section id="guarantee" class="bg-cream py-16 md:py-20 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-10">
        <h2 class="text-3xl md:text-4xl text-ink mb-4">If we don't deliver, you don't pay.</h2>
        <p class="text-muted max-w-lg mx-auto">
          We're new, and we know trust has to be earned. So we've made it as risk-free as possible to work with us.
        </p>
      </div>

      <div class="space-y-4">
        <GuaranteeCard
          number="1"
          headline="Live in 21 days or full refund"
          body="From the day we receive your signed agreement and deposit, your site will be live within 21 calendar days. If it isn't, we refund 100% of what you paid. No questions, no excuses."
        />
        <GuaranteeCard
          number="2"
          headline="Not happy 30 days after launch? Full refund and we transfer the site to you free."
          body="If within 30 days of your site going live you're not satisfied with the result, tell us. We'll refund your build fee in full and transfer all the files and your domain to you at no cost. You don't owe us anything."
        />
        <GuaranteeCard
          number="3"
          headline="You own your domain, your content, and your site. Always."
          body="No lock-in. No proprietary platforms you can't leave. Your domain is registered in your name. Your site files are yours. If you ever want to move to a different provider, we make it as easy as possible."
        />
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section id="process" class="bg-white py-16 md:py-20 px-4">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl md:text-4xl text-ink mb-12 text-center">How it works.</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {[
          {
            n: '01',
            title: 'Free 15-minute call',
            desc: "We learn about your business, your goals, and what's been holding you back. No pitch, no pressure.",
          },
          {
            n: '02',
            title: 'Proposal and quote',
            desc: 'You get a clear scope of work and exact price in writing. No surprises, no upsells waiting around the corner.',
          },
          {
            n: '03',
            title: 'We build',
            desc: 'You review at two checkpoints and give feedback. Your input shapes the final product.',
          },
          {
            n: '04',
            title: 'We launch — and keep it running',
            desc: 'Your site goes live. We handle hosting, updates, and backups every month after that.',
          },
        ].map(step => (
          <div>
            <span class="block text-6xl font-bold text-navy opacity-10 leading-none mb-3" aria-hidden="true">
              {step.n}
            </span>
            <h3 class="text-base font-bold text-ink mb-2" style="font-family: var(--font-sans);">{step.title}</h3>
            <p class="text-muted text-sm leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="bg-cream py-16 md:py-20 px-4">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl text-ink mb-10 text-center">Common questions.</h2>
      <FAQ items={faqItems} />
    </div>
  </section>

  <!-- FINAL CTA -->
  <!-- TODO: Replace Calendly URL with your real booking link -->
  <CTA
    heading="Let's see if we're a fit."
    subheading="Book a free 15-minute call or request a free site audit — no commitment, no sales pressure."
    primaryText="Get a free site audit"
    primaryHref="/audit"
    secondaryText="Book a 15-min call"
    secondaryHref="https://calendly.com/TODO"
    theme="dark"
  />
</Layout>
