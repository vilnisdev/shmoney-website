---
const navLinks = [
  { href: '/about', label: 'About' },
  { href: '/#pricing', label: 'Pricing' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-slate/95 dark:bg-bg/95 backdrop-blur-md border-b border-midnight dark:border-border shadow-sm dark:shadow-none">
  <nav class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between" aria-label="Main navigation">
    <!-- Wordmark -->
    <a href="/" class="flex items-center gap-3 hover:opacity-80 transition-opacity" aria-label="VerumWeb — home">
      <svg width="24" height="30" viewBox="0 0 50 56" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="0"  y="14" width="6" height="28" rx="2" fill="#12c4aa"/>
        <rect x="11" y="6"  width="6" height="44" rx="2" fill="#12c4aa"/>
        <rect x="22" y="18" width="6" height="20" rx="2" fill="#12c4aa" opacity="0.5"/>
        <rect x="33" y="0"  width="6" height="56" rx="2" fill="#12c4aa"/>
        <rect x="44" y="24" width="6" height="12" rx="2" fill="#12c4aa" opacity="0.3"/>
      </svg>
      <span class="font-display text-xl font-bold text-white dark:font-black dark:tracking-tight">VerumWeb</span>
    </a>

    <!-- Desktop links -->
    <ul class="hidden md:flex items-center gap-8 text-sm font-medium text-white" role="list">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class={`opacity-80 hover:opacity-100 transition-opacity ${currentPath === href ? 'opacity-100 underline underline-offset-4' : ''}`}
          >
            {label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="/audit"
          class="nav-cta px-4 py-2 rounded font-semibold focus-visible:outline-2 focus-visible:outline-white"
        >
          Free Audit
        </a>
      </li>
    </ul>

    <!-- Hamburger button (mobile only) -->
    <button
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open navigation menu"
      class="md:hidden p-2 text-white rounded focus-visible:outline-2 focus-visible:outline-white"
    >
      <svg id="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
      <svg id="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="hidden">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-slate dark:bg-bg border-t border-midnight dark:border-border px-4 pb-4"
    role="navigation"
    aria-label="Mobile navigation"
  >
    <ul class="flex flex-col gap-1 pt-3" role="list">
      {navLinks.map(({ href, label }) => (
        <li>
          <a href={href} class="block py-2 text-white opacity-80 font-medium hover:opacity-100 transition-opacity">
            {label}
          </a>
        </li>
      ))}
      <li class="pt-2">
        <a href="/audit" class="nav-cta block px-4 py-2 rounded font-semibold text-center">
          Free Audit
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    const nowOpen = !expanded;
    toggle.setAttribute('aria-expanded', String(nowOpen));
    toggle.setAttribute('aria-label', nowOpen ? 'Close navigation menu' : 'Open navigation menu');
    menu?.classList.toggle('hidden', !nowOpen);
    iconOpen?.classList.toggle('hidden', nowOpen);
    iconClose?.classList.toggle('hidden', !nowOpen);
  });

  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Open navigation menu');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
