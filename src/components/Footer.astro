---
const year = new Date().getFullYear();
---

<footer class="bg-ink dark:bg-surface text-cream dark:text-white border-t border-transparent dark:border-border">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Col 1: Brand -->
      <div>
        <a href="/" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
          <svg width="20" height="26" viewBox="0 0 50 56" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect x="0"  y="14" width="6" height="28" rx="2" fill="#12c4aa"/>
            <rect x="11" y="6"  width="6" height="44" rx="2" fill="#12c4aa"/>
            <rect x="22" y="18" width="6" height="20" rx="2" fill="#12c4aa" opacity="0.5"/>
            <rect x="33" y="0"  width="6" height="56" rx="2" fill="#12c4aa"/>
            <rect x="44" y="24" width="6" height="12" rx="2" fill="#12c4aa" opacity="0.3"/>
          </svg>
          <span class="font-display text-xl font-bold text-white">VerumWeb</span>
        </a>
        <p class="mt-2 text-sm text-muted max-w-xs">
          Web design, consulting, and strategy for Baltimore small businesses.
        </p>
        <p class="mt-3 text-sm font-medium text-white opacity-60">Baltimore, MD</p>
      </div>

      <!-- Col 2: Links -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4 opacity-60" style="font-family: var(--font-sans);">Navigation</h3>
        <ul class="space-y-2 text-sm text-muted" role="list">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li><a href="/about" class="hover:text-white transition-colors">About</a></li>
          <li><a href="/#pricing" class="hover:text-white transition-colors">Pricing</a></li>
          <li><a href="/#faq" class="hover:text-white transition-colors">FAQ</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Col 3: CTA -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4 opacity-60" style="font-family: var(--font-sans);">Get Started</h3>
        <p class="text-sm text-muted mb-4">
          Find out what's holding your online presence back — free, no obligation.
        </p>
        <a
          href="/audit"
          class="inline-block bg-navy text-white px-5 py-2.5 rounded font-semibold text-sm hover:bg-navy-dark transition-colors"
        >
          Free Site Audit
        </a>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-10 pt-6 border-t border-white/10 dark:border-border flex flex-col sm:flex-row justify-between items-center gap-3 text-xs text-muted">
      <span>&copy; {year} VerumWeb. Built in Baltimore.</span>
      <span>
        <!-- TODO: Add privacy policy page and uncomment -->
        <!-- <a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a> &middot; -->
        <!-- <a href="/terms" class="hover:text-white transition-colors">Terms</a> -->
      </span>
    </div>
  </div>
</footer>
