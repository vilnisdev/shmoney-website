---
interface Props {
  tier: string;
  buildFee: string;
  monthly: string;
  features: string[];
  badge?: string;
  highlighted?: boolean;
  ctaHref: string;
  ctaText?: string;
}

const {
  tier,
  buildFee,
  monthly,
  features,
  badge,
  highlighted = false,
  ctaHref,
  ctaText = 'Get started',
} = Astro.props;
---

<div class={`relative flex flex-col rounded-xl p-8 ${
  highlighted
    ? 'bg-navy text-white dark:bg-surface shadow-2xl ring-2 ring-navy dark:ring-navy'
    : 'bg-white text-ink dark:bg-surface border border-gray-200 dark:border-border shadow-sm'
}`}>
  {badge && (
    <span class="absolute -top-3 left-1/2 -translate-x-1/2 text-xs font-bold px-3 py-1 rounded-full whitespace-nowrap bg-success text-white">
      {badge}
    </span>
  )}

  <div class="mb-6">
    <h3 class="text-xl font-bold mb-2" style="font-family: var(--font-sans);">
      {tier}
    </h3>
    <div class="flex items-baseline gap-1">
      <span class="text-4xl font-bold">
        {buildFee}
      </span>
      <span class={`text-sm ${highlighted ? 'text-cream dark:text-muted opacity-80 dark:opacity-100' : 'text-muted'}`}>setup</span>
    </div>
    <p class={`mt-1 text-sm ${highlighted ? 'text-cream dark:text-muted opacity-80 dark:opacity-100' : 'text-muted'}`}>
      then {monthly}/month
    </p>
  </div>

  <ul class="flex-1 space-y-3 mb-8" role="list">
    {features.map(f => (
      <li class="flex items-start gap-3">
        <svg
          class={`mt-0.5 shrink-0 ${highlighted ? 'text-cream dark:text-navy-light' : 'text-success dark:text-navy-light'}`}
          width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"
        >
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        <span class={`text-sm leading-snug ${highlighted ? 'text-cream dark:text-muted' : 'text-ink dark:text-muted'}`}>{f}</span>
      </li>
    ))}
  </ul>

  <a
    href={ctaHref}
    class={`block text-center px-6 py-3 rounded font-semibold text-sm transition-colors focus-visible:outline-2 ${
      highlighted
        ? 'bg-white text-navy hover:bg-cream dark:bg-navy dark:text-white dark:hover:bg-navy-dark focus-visible:outline-white'
        : 'bg-navy text-white hover:bg-navy-dark focus-visible:outline-navy'
    }`}
  >
    {ctaText}
  </a>
</div>
