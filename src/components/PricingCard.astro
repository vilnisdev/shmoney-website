---
interface Props {
  tier: string;
  buildFee: string;
  originalBuildFee?: string;
  monthly: string;
  features: string[];
  badge?: string;
  highlighted?: boolean;
  ctaHref: string;
  ctaText?: string;
}

const {
  tier,
  buildFee,
  originalBuildFee,
  monthly,
  features,
  badge,
  highlighted = false,
  ctaHref,
  ctaText = 'Get started',
} = Astro.props;
---

<div class={`relative flex flex-col rounded-xl p-8 ${
  highlighted
    ? 'bg-navy text-white shadow-2xl ring-2 ring-navy'
    : 'bg-white text-ink border border-gray-200 shadow-sm'
}`}>
  {badge && (
    <span class={`absolute -top-3 left-1/2 -translate-x-1/2 text-xs font-bold px-3 py-1 rounded-full whitespace-nowrap ${
      highlighted ? 'bg-success text-white' : 'bg-success text-white'
    }`}>
      {badge}
    </span>
  )}

  <div class="mb-6">
    <h3 class={`text-xl font-bold mb-2 ${highlighted ? 'text-white' : 'text-ink'}`}
        style="font-family: var(--font-sans);">
      {tier}
    </h3>
    {originalBuildFee && (
      <p class={`text-sm mb-1 ${highlighted ? 'text-cream opacity-60' : 'text-muted'}`}>
        <span class="line-through">{originalBuildFee}</span>
        <span class="ml-2 text-success font-semibold not-italic" style="text-decoration: none;">
          {highlighted ? '' : 'Founding price'}
        </span>
      </p>
    )}
    <div class="flex items-baseline gap-1">
      <span class={`text-4xl font-bold ${highlighted ? 'text-white' : 'text-ink'}`}
            style="font-family: var(--font-display);">
        {buildFee}
      </span>
      <span class={`text-sm ${highlighted ? 'text-cream opacity-80' : 'text-muted'}`}>setup</span>
    </div>
    <p class={`mt-1 text-sm ${highlighted ? 'text-cream opacity-80' : 'text-muted'}`}>
      then {monthly}/month
    </p>
  </div>

  <ul class="flex-1 space-y-3 mb-8" role="list">
    {features.map(f => (
      <li class="flex items-start gap-3">
        <svg
          class={`mt-0.5 shrink-0 ${highlighted ? 'text-cream' : 'text-success'}`}
          width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"
        >
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        <span class={`text-sm leading-snug ${highlighted ? 'text-cream' : 'text-ink'}`}>{f}</span>
      </li>
    ))}
  </ul>

  <a
    href={ctaHref}
    class={`block text-center px-6 py-3 rounded font-semibold text-sm transition-colors focus-visible:outline-2 ${
      highlighted
        ? 'bg-white text-navy hover:bg-cream focus-visible:outline-white'
        : 'bg-navy text-white hover:bg-navy-dark focus-visible:outline-navy'
    }`}
  >
    {ctaText}
  </a>
</div>
