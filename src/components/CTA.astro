---
interface Props {
  heading: string;
  subheading?: string;
  primaryText: string;
  primaryHref: string;
  secondaryText?: string;
  secondaryHref?: string;
  theme?: 'dark' | 'light';
}

const {
  heading,
  subheading,
  primaryText,
  primaryHref,
  secondaryText,
  secondaryHref,
  theme = 'dark',
} = Astro.props;

const isDark = theme === 'dark';
---

<section class={`py-16 px-4 ${isDark ? 'bg-navy text-white' : 'bg-cream text-ink'}`}>
  <div class="max-w-3xl mx-auto text-center">
    <h2 class={`text-3xl md:text-4xl font-bold mb-4 ${isDark ? 'text-white' : 'text-ink'}`}>{heading}</h2>
    {subheading && (
      <p class={`text-lg mb-8 ${isDark ? 'text-cream opacity-90' : 'text-muted'}`}>{subheading}</p>
    )}
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href={primaryHref}
        class={`inline-block px-7 py-3.5 rounded font-semibold text-base transition-colors focus-visible:outline-2 ${
          isDark
            ? 'bg-white text-navy hover:bg-cream focus-visible:outline-white'
            : 'bg-navy text-white hover:bg-navy-dark focus-visible:outline-navy'
        }`}
      >
        {primaryText}
      </a>
      {secondaryText && secondaryHref && (
        <a
          href={secondaryHref}
          class={`inline-block px-7 py-3.5 rounded font-semibold text-base border-2 transition-colors focus-visible:outline-2 ${
            isDark
              ? 'border-white text-white hover:bg-white hover:text-navy focus-visible:outline-white'
              : 'border-navy text-navy hover:bg-navy hover:text-white focus-visible:outline-navy'
          }`}
        >
          {secondaryText}
        </a>
      )}
    </div>
  </div>
</section>
